# Ice Lake cluster (dsb_k8s_perf harvest-k612 profile): the experiment
# scripts' clabsvr/clabcl1 aliases map to node-0 (control plane + load
# generators) and node-4 (harvest worker). Original c6420 setup used
# 192.168.10.10 / 192.168.10.11.
Host clabsvr
  User USER
  Hostname node-0
  Port 22
  IdentityFile ~/.ssh/cloudlab_key
  StrictHostKeyChecking=no
  ServerAliveInterval 120

Host clabcl1
  User USER
  Hostname node-4
  Port 22
  IdentityFile ~/.ssh/cloudlab_key
  StrictHostKeyChecking=no
  ServerAliveInterval 120
